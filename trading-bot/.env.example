# =============================================================================
# Trading Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# .env is git-ignored — NEVER commit real API keys.

# ---------------------------------------------------------------------------
# Alpaca Markets — Broker API
# ---------------------------------------------------------------------------
# Sign up at https://alpaca.markets — paper trading is free.
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true                          # "true" = paper trading, "false" = live

# ---------------------------------------------------------------------------
# Quiver Quantitative — Politician Trade Data (Option B, Prompt 5)
# ---------------------------------------------------------------------------
# Free tier: https://quiverquant.com — STOCK Act congressional disclosures.
# Leave empty to disable politician signals entirely.
QUIVER_API_KEY=your_quiver_key_here

# ---------------------------------------------------------------------------
# Dashboard — Web UI Access
# ---------------------------------------------------------------------------
# Password for the Flask dashboard at http://localhost:8080.
# No username — just the password. Leave empty for dev mode (no auth).
DASHBOARD_PASSWORD=changeme

# Secret key for signing session cookies. Generated automatically if not set.
# Set a fixed value to keep sessions alive across container restarts.
# DASHBOARD_SECRET=

# ---------------------------------------------------------------------------
# GA Evolver — Tuning (optional, defaults shown)
# ---------------------------------------------------------------------------
# GA_POPULATION=10000                       # agents per asset class (Phase 1)
# GA_GENERATIONS=500                        # generations per weekly batch

# ---------------------------------------------------------------------------
# Shared Volume Directories (optional, defaults shown)
# ---------------------------------------------------------------------------
# CHAMPIONS_DIR=champions                  # champion DNA + model checkpoints
# CHALLENGERS_DIR=challengers              # challenger DNA for circuit-breaker
# ARCHIVE_DIR=archive                      # demoted champion archive
# LOGS_DIR=logs                            # trade logs, ledger, controls, evo logs
