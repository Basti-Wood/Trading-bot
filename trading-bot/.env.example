# Copy to .env. Keys stay on the server and never go to the dashboard.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALLOW_LIVE_TRADING=false
ALPACA_DATA_FEED=iex
# market scans Alpaca's listed tradable equities; watchlist uses SYMBOLS only.
UNIVERSE_MODE=market
SYMBOLS=SPY,QQQ,IWM
SCAN_CANDIDATES=20
SCAN_INTERVAL_MINUTES=30
SCAN_MIN_PRICE=5
# Feed-specific previous-day volume, not consolidated volume on IEX.
SCAN_MIN_DOLLAR_VOLUME=1000000

# Trading 212 Invest: independent execution for verified NON-US listings.
# Start with demo API credentials; new entries always start paused.
# Enable account, metadata, portfolio, orders read/execute and order/transaction history.
TRADING212_ENABLED=true
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_PAPER=true
TRADING212_ALLOW_LIVE_TRADING=false
# Exact broker ticker/ISIN to provider symbol/MIC/currency mappings (no credentials here).
TRADING212_INSTRUMENTS_FILE=config/trading212-instruments.json
# Uses only Trading 212 equity/cash. The cap is in THAT account's currency.
TRADING212_CAPITAL_FRACTION=1.0
TRADING212_CAPITAL_CAP=0
# Share reserved for daily predictions; the daily loop gets the remainder.
# 0 = loop only, 1 = predictions only. Each broker uses only its own account funds.
TRADING212_PREDICTION_SHARE=0.50
# These are three local model votes. US news is not reused for European listings.
TRADING212_MIN_AGREEING_VOTES=2
# Foreign-currency entries are opt-in and need fresh FX data; conversion fees apply.
TRADING212_ALLOW_FX=false
# Non-US candles and prices: yahoo (free, covers Xetra/Euronext; default) or twelvedata.
# Prices older than TRADING212_MAX_QUOTE_AGE_SECONDS never size an order.
TRADING212_DATA_SOURCE=yahoo
TRADING212_MAX_QUOTE_AGE_SECONDS=1200
# Only for TRADING212_DATA_SOURCE=twelvedata: its free plan is US-only; European data needs a paid plan.
# No subscription is created by the bot. Missing/delayed data blocks entries.
TWELVEDATA_API_KEY=
# Combined money/return use daily reference FX for display, never for execution.
REPORTING_CURRENCY=EUR

# both runs daily investing and day trading together in one process/account.
# Retain your existing daily DATA_DIR. Both/daytrade are paper-only.
TRADING_MODE=both
# Daily limit/bracket orders can queue while closed for the next regular session.
# Day trading still requires fresh regular-session prices.
QUEUE_DAILY_ORDERS=true
# Split the existing capital allowance; account-wide limits still apply.
DAYTRADE_CAPITAL_SHARE=0.50
DAYTRADE_MAX_POSITIONS=3
DAYTRADE_MAX_ENTRIES_PER_SYMBOL=3
DAYTRADE_COOLDOWN_MINUTES=5
# Rule-based setups on one-minute bars decide day-trading entries; models only veto.
# orb = opening-range breakout, noise_breakout = noise-boundary momentum (both published),
# vwap_pullback, vwap_reversion = practitioner setups (negative gross edge in our replay).
DAYTRADE_STRATEGIES=orb,noise_breakout
# Upper bound on any setup's stop distance.
DAYTRADE_STOP_LOSS=0.01
DAYTRADE_FLATTEN_MINUTES=10
# Time limits for target-based setups and for positions opened before the playbook.
DAYTRADE_MAX_HOLD_MINUTES=15
DAYTRADE_LET_WINNERS_RUN_MINUTES=60
# Target-based setups: once up TRIGGER, exit if the trade gives back GAP from its peak.
DAYTRADE_TRAIL_TRIGGER=0.006
DAYTRADE_TRAIL_GAP=0.004

# Trading-loop: tested, unchanged stock strategy versions from this folder can be switched on in the
# dashboard (paper only). Relative paths start at the trading-bot folder.
TRADING_LOOP_DIR=trading-loop
# Stocks the latest stress test did not cover are tuned here first (about 2 s each).
TRADING_LOOP_TIMEOUT_SECONDS=900

# Daily investing: three prediction models plus the LLM vote; trade when this many agree.
MIN_AGREEING_VOTES=3

# Llama is asked once per stock each New York day; successful replies are reused.
# A separate market overview is stored with the stock summaries and has no vote.
# Neutral/missing news abstains. Day trading never uses the LLM.
# Your FreeLLM proxy. Paste its unified key here, not in source control.
FREELLM_BASE_URL=https://ai.bastiwood.com/v1
FREELLM_API_KEY=
# Leave empty to discover an available Llama model; or set one installed Llama model ID.
FREELLM_MODELS=

# Read-only API for an external assistant (e.g. a Custom GPT Action) that checks in once a day.
# Empty = off. Use 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))".
# The token only works for GET /api/readonly/...: it can never trade or change settings.
READONLY_API_TOKEN=
READONLY_API_DAILY_LIMIT=100
# Public HTTPS address of the dashboard (reverse proxy); the GPT schema points its server here.
# DASHBOARD_ORIGINS=https://trade.bastiwood.com

# Required in Docker / when HOST is not loopback. Username: admin.
DASHBOARD_PASSWORD=
HOST=127.0.0.1
PORT=1337
# Set a LAN IP or 0.0.0.0 to expose the Docker port on your network.
BIND_ADDRESS=127.0.0.1

# Sizing follows the account. CAPITAL_FRACTION of current equity is the bot's capital;
# each position gets MAX_POSITION_FRACTION of that, all positions at most MAX_GROSS_FRACTION.
# Example: $2,000 equity -> $200 per position; $100,000 -> $10,000 per position.
CAPITAL_FRACTION=1.0
# Optional hard ceiling in dollars on top of the percentage; 0 = no ceiling.
MAX_CAPITAL_USD=0
MAX_POSITION_FRACTION=0.10
MAX_GROSS_FRACTION=0.30
MAX_DAILY_LOSS=0.02
STOP_LOSS=0.05
TAKE_PROFIT=0.10
COST_BPS_PER_SIDE=10
MIN_EDGE_BPS=10

RETRAIN_HOURS=24
# FreqAI-inspired independent model expiry; legacy checkpoints use data_through as fallback.
MODEL_MAX_AGE_HOURS=168
# Resolved local examples get extra weight only inside the training partition (1 to 3).
FEEDBACK_SAMPLE_WEIGHT=2
# Most recent labeled sessions held out of fitting, plus a two-row boundary gap (20 to 120).
VALIDATION_BARS=30
TRAINING_MEMORY_MB=4096
TRAINING_TIMEOUT_SECONDS=900
HISTORY_DAYS=1800
MAX_BARS=1500
DATA_DIR=data
